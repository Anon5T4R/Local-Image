# PKGBUILD do Local Image para Arch (uso pessoal do João; não publicado no AUR).
# Instala a árvore FHS (bin/ + share/) do tarball da release — o mesmo artefato
# que o package.sh gera —, então pacman -Ql lista os arquivos e pacman -R remove
# tudo. O sha256 fica SKIP porque o hash só existe após a release existir; confie
# no transport (HTTPS) ou preencha manualmente com `updpkgsums`.
#
#   makepkg -si

pkgname=local-image
pkgver=0.5.3
pkgrel=1
pkgdesc='Visualizador de imagens 100% local e offline — export sem EXIF'
arch=(x86_64)
url='https://github.com/Anon5T4R/Local-Image'
license=('MIT OR Apache-2.0')
depends=(glibc gcc-libs libxcb libxrandr libxi libxcursor libxkbcommon)
optdepends=('xdg-desktop-portal: seletor nativo de arquivos (GNOME/KDE já trazem)')
source=("local-image-$pkgver-linux-x86_64.tar.gz::https://github.com/Anon5T4R/Local-Image/releases/download/v$pkgver/local-image-$pkgver-linux-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir"
  install -dm755 "$pkgdir/usr"
  cp -a "local-image-$pkgver-linux-x86_64/bin" "$pkgdir/usr/"
  cp -a "local-image-$pkgver-linux-x86_64/share" "$pkgdir/usr/"
}
